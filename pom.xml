<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>io.github.kevinlove0712</groupId>
  <artifactId>fractional-indexing-java</artifactId>
  <version>0.1.0</version>
  <name>Fractional Indexing for Java</name>
  <description>Dependency-free Java implementation of rocicorp-compatible default fractional indexing.</description>
  <url>https://github.com/kevinlove0712/fractional-indexing-java</url>
  <developers>
    <developer>
      <id>kevinlove0712</id>
      <name>kevinlove0712</name>
      <url>https://github.com/kevinlove0712</url>
    </developer>
  </developers>
  <scm>
    <connection>scm:git:https://github.com/kevinlove0712/fractional-indexing-java.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/kevinlove0712/fractional-indexing-java.git</developerConnection>
    <url>https://github.com/kevinlove0712/fractional-indexing-java</url>
    <tag>v0.1.0</tag>
  </scm>
  <licenses><license><name>CC0 1.0 Universal</name><url>https://creativecommons.org/publicdomain/zero/1.0/</url><distribution>repo</distribution></license></licenses>
  <properties>
    <maven.compiler.release>8</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
  </properties>
  <dependencies>
    <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><version>5.10.5</version><scope>test</scope></dependency>
  </dependencies>
  <build>
    <resources>
      <resource>
        <directory>${project.basedir}</directory>
        <targetPath>META-INF</targetPath>
        <includes><include>LICENSE</include><include>UPSTREAM.md</include></includes>
      </resource>
    </resources>
    <plugins>
    <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.13.0</version></plugin>
    <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><version>3.2.5</version></plugin>
    <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-jar-plugin</artifactId><version>3.4.1</version><configuration><archive><manifestEntries><Automatic-Module-Name>dev.fractionalindexing</Automatic-Module-Name></manifestEntries></archive></configuration></plugin>
    </plugins>
  </build>
  <profiles>
    <!-- Build releases with JDK 21; the library bytecode remains Java 8 compatible. -->
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <version>3.3.1</version>
            <executions><execution><id>sources</id><goals><goal>jar-no-fork</goal></goals></execution></executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <version>3.11.2</version>
            <executions><execution><id>javadoc</id><goals><goal>jar</goal></goals></execution></executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>3.2.8</version>
            <executions><execution><id>sign</id><phase>verify</phase><goals><goal>sign</goal></goals></execution></executions>
          </plugin>
          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>0.12.0</version>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
              <autoPublish>false</autoPublish>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
